{
  "name": "@snapshot-machine/frontend",
  "version": "0.1.0",
  "exports": {
    ".": "./src/main.tsx"
  },
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "types": ["vite/client"],
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "jsx": "react-jsx",
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "imports": {
    "@/": "./src/",
    "react": "npm:react@^19.3.1",
    "react-dom": "npm:react-dom@^19.3.1",
    "@types/node": "npm:@types/node@^24.19.2",
    "@types/react": "npm:@types/react@^19.3.0",
    "@types/react-dom": "npm:@types/react-dom@^19.3.0",
    "@vitejs/plugin-react": "npm:@vitejs/plugin-react@^6.1.2",
    "typescript": "npm:typescript@~7.0.2",
    "vite": "npm:vite@^8.3.5"
  },
  "tasks": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "deno check src/main.tsx"
  }
}
