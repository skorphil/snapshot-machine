<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>Snapshot Machine Project</vendor>
  <vendor_url>https://github.com/skorphil/snapshot-machine</vendor_url>

  <action id="com.snapshot_machine.BtrbkService1.configure">
    <description>Change btrbk configuration files</description>
    <message>Authentication is required to change btrbk configuration</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
  </action>

  <action id="com.snapshot_machine.BtrbkService1.run">
    <description>Run a btrbk backup now</description>
    <message>Authentication is required to start a backup</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
  </action>

  <action id="com.snapshot_machine.BtrbkService1.schedule">
    <description>Change the automatic backup schedule</description>
    <message>Authentication is required to change the automatic backup schedule</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
  </action>
</policyconfig>
