{
  "imports": {
    "dbus-next": "npm:dbus-next@0.10.2",
    "@std/assert": "jsr:@std/assert@1",
    "@std/path": "jsr:@std/path@1"
  },
  "tasks": {
    "dev": "deno run --allow-all src/main.ts",
    "build": "deno compile --allow-read --allow-write --allow-run --allow-env --allow-sys --allow-net --output dist/btrbk-gui-helper src/main.ts",
    "test": "deno test --allow-read --allow-write --allow-run --allow-env src/"
  }
}
